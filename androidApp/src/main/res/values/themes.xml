<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.Isida.SplashScreen" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/neutral085</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/bg_splash_screen</item>
        <item name="postSplashScreenTheme">@style/Theme.Isida</item>
    </style>

    <!-- Compose -->
    <style name="Theme.Isida" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/neutral085</item>

        <!-- Primary brand color. -->
        <item name="android:colorPrimary">@color/neutral085</item>
        <item name="android:colorPrimaryDark">@color/neutral085</item>
        <item name="android:colorAccent">@color/neutral085</item>
    </style>
</resources>