<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Legacy permissions (Android 11 and below). Classic discovery required location
         pre-Android-12; capped at API 30 since the app never derives physical location. -->
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" android:maxSdkVersion="30" />

    <!-- New permissions (Android 12+) -->
    <!-- This app uses CLASSIC Bluetooth discovery (BluetoothAdapter.startDiscovery), so do NOT
         add usesPermissionFlags="neverForLocation" — it can suppress classic ACTION_FOUND results. -->
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />

</manifest>